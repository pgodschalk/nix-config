{
  "astro-ls": {
    "command": "astro-ls",
    "args": ["--stdio"],
    "extensionToLanguage": {
      ".astro": "astro"
    },
    "initializationOptions": {
      "typescript": {
        "tsdk": "@astroTsdk@"
      }
    }
  },
  "awk-language-server": {
    "command": "awk-language-server",
    "extensionToLanguage": {
      ".awk": "awk",
      ".gawk": "awk",
      ".mawk": "awk",
      ".nawk": "awk"
    }
  },
  "bash-language-server": {
    "command": "bash-language-server",
    "args": ["start"],
    "extensionToLanguage": {
      ".ash": "bash",
      ".bash": "bash",
      ".bazelrc": "bash",
      ".cshrc": "bash",
      ".dash": "bash",
      ".ebuild": "bash",
      ".eclass": "bash",
      ".ksh": "bash",
      ".mksh": "bash",
      ".sh": "bash",
      ".tcshrc": "bash",
