  "yaml-language-server": {
    "command": "yaml-language-server",
    "args": ["--stdio"],
    "extensionToLanguage": {
      ".sublime-syntax": "yaml",
      ".yaml": "yaml",
      ".yml": "yaml"
    },
    "initializationOptions": {
      "yaml": {
        "format": {
          "enable": true
        },
        "schemas": {
          "https://raw.githubusercontent.com/ansible/ansible-lint/main/src/ansiblelint/schemas/inventory.json": [
            "./inventory/*.yaml",
            "hosts.yml"
          ]
        }
      }
    },
    "settings": {
      "yaml": {
        "format": {
          "enable": true
        },
        "schemas": {
          "https://raw.githubusercontent.com/ansible/ansible-lint/main/src/ansiblelint/schemas/inventory.json": [
