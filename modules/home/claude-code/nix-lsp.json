  },
  "nixd": {
    "command": "nixd",
    "extensionToLanguage": {
      ".nix": "nix"
    },
    "initializationOptions": {
      "nixd": {
        "nixpkgs": {
          "expr": "import (builtins.getFlake \"/Users/patrick/Developer/github.com/pgodschalk/nix-config\").inputs.nixpkgs { }"
        },
        "options": {
          "nix-darwin": {
            "expr": "(builtins.getFlake \"/Users/patrick/Developer/github.com/pgodschalk/nix-config\").darwinConfigurations.Patricks-MacBook-Pro.options"
          },
          "home-manager": {
            "expr": "(builtins.getFlake \"/Users/patrick/Developer/github.com/pgodschalk/nix-config\").darwinConfigurations.Patricks-MacBook-Pro.options.home-manager.users.type.getSubOptions [ ]"
          }
        }
      }
    },
    "settings": {
      "nixpkgs": {
        "expr": "import (builtins.getFlake \"/Users/patrick/Developer/github.com/pgodschalk/nix-config\").inputs.nixpkgs { }"
      },
      "options": {
        "home-manager": {
          "expr": "(builtins.getFlake \"/Users/patrick/Developer/github.com/pgodschalk/nix-config\").darwinConfigurations.Patricks-MacBook-Pro.options.home-manager.users.type.getSubOptions [ ]"
        },
        "nix-darwin": {
          "expr": "(builtins.getFlake \"/Users/patrick/Developer/github.com/pgodschalk/nix-config\").darwinConfigurations.Patricks-MacBook-Pro.options"
        }
      }
    }
  },
  "nu-lsp": {
