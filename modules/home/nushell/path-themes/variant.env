STARSHIP_CONFIG=@extras@/src/starship/@variant@.toml
GIT_CONFIG_GLOBAL=@out@/@variant@.gitconfig
RIPGREP_CONFIG_PATH=@extras@/src/ripgrep/@variant@.conf

# difftastic has no theme, only a hint choosing between its built-in
# bright and dim colours.
DFT_BACKGROUND=@background@

# lumen takes one of its built-in theme names and no theme file, so
# this is upstream's plain dracula and, on the light side, the nearest
# of its light built-ins.
LUMEN_THEME=@lumenTheme@

# moor takes a Chroma style name from its built-in registry and no
# palette file, so this is Chroma's plain dracula and, on the light
# side, the nearest of its light styles.
MOOR='--style=@moorStyle@ --no-linenumbers --quit-if-one-screen --statusbar=bold'
